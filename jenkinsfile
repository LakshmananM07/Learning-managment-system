pipeline {
    agent any

    parameters {
        string(name: 'DOCKERHUB_USERNAME', defaultValue: 'lakshmanan2007', description: 'DockerHub Username')
        string(name: 'IMAGE_NAME', defaultValue: 'lms', description: 'Docker Repository Name')
        string(name: 'IMAGE_TAG', defaultValue: 'v3', description: 'Image Tag')
        string(name: 'DOCKERHUB_CREDENTIALS_ID', defaultValue: 'lakshmanan2007', description: 'Jenkins Credentials ID for DockerHub')
        string(name: 'PROJECT_DIR', defaultValue: '.', description: 'Project Directory')
    }

    environment {
        FULL_IMAGE = "${params.DOCKERHUB_USERNAME}/${params.IMAGE_NAME}:${params.IMAGE_TAG}"
        KUBECONFIG = "C:/Users/nivet/.kube/config"
    }

    stages {
        stage('Checkout / Setup') {
            steps {
                script {
                    try {
                        checkout scm
                    } catch (Exception e) {
                        echo "No SCM configured or using local directory: ${params.PROJECT_DIR}"
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir(params.PROJECT_DIR) {
                    script {
                        if (isUnix()) {
                            sh "docker build -t ${FULL_IMAGE} ."
                        } else {
                            bat "docker build -t ${FULL_IMAGE} ."
                        }
                    }
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                dir(params.PROJECT_DIR) {
                    script {
                        withCredentials([usernamePassword(credentialsId: params.DOCKERHUB_CREDENTIALS_ID, usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                            if (isUnix()) {
                                sh "echo \$DH_PASS | docker login -u \$DH_USER --password-stdin"
                                sh "docker push ${FULL_IMAGE}"
                            } else {
                                bat "docker login -u %DH_USER% -p %DH_PASS%"
                                bat "docker push ${FULL_IMAGE}"
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                dir(params.PROJECT_DIR) {
                    script {
                        if (isUnix()) {
                            sh "kubectl apply -f k8s/v3-deployment.yaml"
                            sh "kubectl apply -f k8s/v3-service.yaml"
                        } else {
                            bat "kubectl --kubeconfig=\"%KUBECONFIG%\" apply -f k8s/v3-deployment.yaml"
                            bat "kubectl --kubeconfig=\"%KUBECONFIG%\" apply -f k8s/v3-service.yaml"
                        }
                    }
                }
            }
        }

        stage('Verify Rollout') {
            steps {
                script {
                    if (isUnix()) {
                        sh "kubectl rollout status deployment/lms-v3 --timeout=90s"
                        sh "kubectl get svc lms-v3-service"
                    } else {
                        bat "kubectl --kubeconfig=\"%KUBECONFIG%\" rollout status deployment/lms-v3 --timeout=90s"
                        bat "kubectl --kubeconfig=\"%KUBECONFIG%\" get svc lms-v3-service"
                    }
                }
            }
        }
    }

    post {
        success {
            echo "LMS v3 successfully built, pushed to DockerHub (${FULL_IMAGE}), and deployed to Kubernetes."
        }
        failure {
            echo "Pipeline failed. Check Jenkins logs for details."
        }
    }
}